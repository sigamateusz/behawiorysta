---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ConsultationForm from "@/components/consultations/ConsultationForm";
import { createClient } from "@/lib/supabase";
import { getAvailableSlots } from "@/lib/availability";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const initialSlots = supabase ? (await getAvailableSlots(supabase, new Date())).map((slot) => slot.toISOString()) : [];
---

<Layout title="Umów konsultację">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent sm:text-3xl">
          Umów konsultację
        </h1>
        <p class="mb-6 text-sm text-blue-100/70">
          Najpierw wypełnij ankietę o swoim psie, a potem wybierz wolny termin.
        </p>
        <ConsultationForm client:load initialSlots={initialSlots} />
      </div>
    </div>
  </div>
</Layout>
