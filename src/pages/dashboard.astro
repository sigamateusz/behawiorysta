---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { visibleSubmissions } from "@/lib/behaviorist-submissions";
import { blockSelection, coversWarsawDay, isRangeInside, overlappingSlotHours } from "@/lib/blocks";
import { formatSlotLabel, warsawDayHeading, warsawDayKey } from "@/lib/slot-label";
import { SLOT_MINUTES, SLOT_STARTS, warsawDayBounds, warsawWallTime } from "@/lib/slots";
import { createClient } from "@/lib/supabase";

const STATUS_LABELS: Record<string, string> = {
  pending: "Oczekuje na decyzję",
  accepted: "Zaakceptowana",
};

const BLOCK_ERROR_SAVE = "Nie udało się zapisać blokady.";
const BLOCK_ERRORS: Record<string, string> = {
  date: "Tej daty nie da się zablokować.",
  empty: "Wybierz cały dzień albo godzinę.",
  hour: "Tej godziny nie ma w grafiku.",
  duplicate: "Ta blokada już jest zapisana.",
  save: BLOCK_ERROR_SAVE,
  delete: "Nie udało się usunąć blokady.",
};

const WEEKDAYS = ["Pn", "Wt", "Śr", "Cz", "Pt", "So", "Nd"];
const MONTH_PATTERN = /^\d{4}-(0[1-9]|1[0-2])$/;
const SLOT_MS = SLOT_MINUTES * 60_000;

interface SubmissionRow {
  id: string;
  dog_name: string;
  breed: string;
  slot_start: string;
  status: string;
  created_at: string;
}

interface BlockRow {
  id: string;
  starts_at: string;
  ends_at: string;
}

interface DayItem {
  id: string;
  dogName: string;
  time: string;
}

interface DayCell {
  day: number | null;
  dayKey: string | null;
  items: DayItem[];
  wholeDayBlocked: boolean;
  blockedHours: string[];
  canBlock: boolean;
}

function statusLabel(status: string): string {
  return STATUS_LABELS[status] ?? status;
}

function shiftMonth(month: string, delta: number): string {
  const year = Number(month.slice(0, 4));
  const monthIndex = Number(month.slice(5, 7)) - 1;
  const shifted = new Date(Date.UTC(year, monthIndex + delta, 1));
  const nextYear = shifted.getUTCFullYear();
  const nextMonth = String(shifted.getUTCMonth() + 1).padStart(2, "0");
  return `${nextYear}-${nextMonth}`;
}

/** Column 0 is Monday. 2024-01-01 is a Monday. */
function mondayColumn(dayKey: string): number {
  const [year, month, day] = dayKey.split("-").map(Number);
  const target = Date.UTC(year, month - 1, day);
  const knownMonday = Date.UTC(2024, 0, 1);
  const diffDays = Math.round((target - knownMonday) / 86_400_000);
  return ((diffDays % 7) + 7) % 7;
}

function warsawHourMinute(instant: string): string {
  const parts = new Intl.DateTimeFormat("pl-PL", {
    timeZone: "Europe/Warsaw",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(new Date(instant));
  const hour = (parts.find((part) => part.type === "hour")?.value ?? "").replace(/\D/g, "");
  const minute = (parts.find((part) => part.type === "minute")?.value ?? "").replace(/\D/g, "");
  return `${hour.padStart(2, "0")}:${minute.padStart(2, "0")}`;
}

function formatHour(hour: number): string {
  return `${String(hour).padStart(2, "0")}:00`;
}

function blankCell(): DayCell {
  return {
    day: null,
    dayKey: null,
    items: [],
    wholeDayBlocked: false,
    blockedHours: [],
    canBlock: false,
  };
}

function overlapsDay(row: BlockRow, day: string): boolean {
  const bounds = warsawDayBounds(day);
  return (
    new Date(row.starts_at).getTime() < bounds.ends_at.getTime() &&
    new Date(row.ends_at).getTime() > bounds.starts_at.getTime()
  );
}

function blockRowLabel(row: BlockRow, day: string): string {
  if (coversWarsawDay(row, day)) {
    return "Cały dzień";
  }
  const startMs = new Date(row.starts_at).getTime();
  const endMs = new Date(row.ends_at).getTime();
  const slotHour = SLOT_STARTS.find((hour) => warsawWallTime(day, hour, 0).getTime() === startMs);
  if (slotHour !== undefined && endMs - startMs === SLOT_MS) {
    return formatHour(slotHour);
  }
  return `${warsawHourMinute(row.starts_at)}–${warsawHourMinute(row.ends_at)}`;
}

function hourFullyCovered(day: string, hour: number, rows: readonly BlockRow[]): boolean {
  const starts_at = warsawWallTime(day, hour, 0);
  const ends_at = new Date(starts_at.getTime() + SLOT_MS);
  return rows.some((row) => isRangeInside({ starts_at, ends_at }, row));
}

const now = new Date();
const defaultMonth = warsawDayKey(now).slice(0, 7);
const requestedMonth = Astro.url.searchParams.get("month");
const month = requestedMonth !== null && MONTH_PATTERN.test(requestedMonth) ? requestedMonth : defaultMonth;
const year = Number(month.slice(0, 4));
const monthIndex = Number(month.slice(5, 7)) - 1;
const previousMonth = shiftMonth(month, -1);
const nextMonth = shiftMonth(month, 1);
const formattedMonth = new Intl.DateTimeFormat("pl-PL", {
  timeZone: "Europe/Warsaw",
  month: "long",
  year: "numeric",
}).format(new Date(Date.UTC(year, monthIndex, 15, 12)));
const monthLabel = formattedMonth.charAt(0).toLocaleUpperCase("pl-PL") + formattedMonth.slice(1);

const requestedDay = Astro.url.searchParams.get("day");
let selectedDay = "";
let showPanel = false;
if (requestedDay !== null && requestedDay.slice(0, 7) === month) {
  const selection = blockSelection({ day: requestedDay, wholeDay: true, hours: [] }, now);
  if (selection.ok) {
    selectedDay = requestedDay;
    showPanel = true;
  }
}

let panelHeading = "";
if (showPanel) {
  const heading = warsawDayHeading(warsawDayBounds(selectedDay).starts_at);
  panelHeading = heading.charAt(0).toLocaleUpperCase("pl-PL") + heading.slice(1);
}

const blockErrorCode = Astro.url.searchParams.get("block_error");
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadFailed = false;
let submissions: SubmissionRow[] = [];
let blocks: BlockRow[] = [];

if (!supabase) {
  loadFailed = true;
} else {
  const monthStart = warsawDayBounds(`${month}-01`).starts_at.toISOString();
  const nextMonthStart = warsawDayBounds(`${nextMonth}-01`).starts_at.toISOString();
  const [consultationsResult, blocksResult] = await Promise.all([
    supabase.from("consultations").select("id, dog_name, breed, slot_start, status, created_at"),
    supabase
      .from("availability_blocks")
      .select("id, starts_at, ends_at")
      .lt("starts_at", nextMonthStart)
      .gt("ends_at", monthStart),
  ]);

  if (consultationsResult.error) {
    loadFailed = true;
  } else if (blocksResult.error) {
    loadFailed = true;
  } else {
    submissions = visibleSubmissions(consultationsResult.data, now);
    blocks = blocksResult.data;
  }
}

const blockErrorMessage =
  blockErrorCode === null || loadFailed ? null : (BLOCK_ERRORS[blockErrorCode] ?? BLOCK_ERROR_SAVE);

const panelBlocks: BlockRow[] = [];
const openHours: number[] = [];
let panelCovered = false;

if (!loadFailed && showPanel) {
  for (const row of blocks) {
    if (overlapsDay(row, selectedDay)) {
      panelBlocks.push(row);
    }
  }
  panelBlocks.sort((left, right) => {
    const byStart = left.starts_at.localeCompare(right.starts_at);
    if (byStart !== 0) {
      return byStart;
    }
    return left.id.localeCompare(right.id);
  });
  panelCovered = panelBlocks.some((row) => coversWarsawDay(row, selectedDay));
  if (!panelCovered) {
    for (const hour of SLOT_STARTS) {
      if (!hourFullyCovered(selectedDay, hour, panelBlocks)) {
        openHours.push(hour);
      }
    }
  }
}

const cells: DayCell[] = [];

if (!loadFailed) {
  const itemsByDay = new Map<string, DayItem[]>();
  for (const row of submissions) {
    const key = warsawDayKey(row.slot_start);
    const items = itemsByDay.get(key) ?? [];
    items.push({
      id: row.id,
      dogName: row.dog_name,
      time: warsawHourMinute(row.slot_start),
    });
    itemsByDay.set(key, items);
  }

  const dayCount = new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
  const firstKey = warsawDayKey(new Date(Date.UTC(year, monthIndex, 1, 12)));

  for (let index = 0; index < mondayColumn(firstKey); index += 1) {
    cells.push(blankCell());
  }

  for (let day = 1; day <= dayCount; day += 1) {
    const key = warsawDayKey(new Date(Date.UTC(year, monthIndex, day, 12)));
    const wholeDayBlocked = blocks.some((row) => coversWarsawDay(row, key));
    cells.push({
      day,
      dayKey: key,
      items: itemsByDay.get(key) ?? [],
      wholeDayBlocked,
      blockedHours: wholeDayBlocked ? [] : overlappingSlotHours(key, blocks).map((hour) => formatHour(hour)),
      canBlock: blockSelection({ day: key, wholeDay: true, hours: [] }, now).ok,
    });
  }

  const trailingBlankCount = (7 - (cells.length % 7)) % 7;
  for (let index = 0; index < trailingBlankCount; index += 1) {
    cells.push(blankCell());
  }
}
---

<Layout title="Zgłoszenia">
  <div class="bg-background min-h-screen p-4">
    <div class="mx-auto max-w-6xl">
      <Topbar />
      <h1 class="mb-4 text-2xl font-semibold text-foreground">Zgłoszenia</h1>

      {loadFailed ? (
        <p class="rounded-xl border border-border bg-card px-4 py-3 text-card-foreground" role="alert">
          Nie udało się wczytać kalendarza.
        </p>
      ) : (
        <>
          {blockErrorMessage ? (
            <p class="mb-4 rounded-xl border border-border bg-card px-4 py-3 text-card-foreground" role="alert">
              {blockErrorMessage}
            </p>
          ) : null}

          <nav class="mb-4 flex flex-wrap items-center justify-between gap-3" aria-label="Miesiąc">
            <a
              href={`/dashboard?month=${previousMonth}`}
              class="text-primary hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
            >
              Poprzedni miesiąc
            </a>
            <p class="text-lg font-semibold text-foreground">{monthLabel}</p>
            <a
              href={`/dashboard?month=${nextMonth}`}
              class="text-primary hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
            >
              Następny miesiąc
            </a>
          </nav>

          <div class="grid grid-cols-7 gap-2 text-center text-sm text-muted-foreground">
            {WEEKDAYS.map((weekday) => (
              <div class="font-medium">{weekday}</div>
            ))}
          </div>

          <div class="mt-2 grid grid-cols-7 gap-2">
            {cells.map((cell) => (
              <div
                class:list={[
                  "min-h-24 min-w-0 overflow-hidden rounded-lg p-2",
                  cell.day === null
                    ? ""
                    : cell.items.length > 0
                      ? "border border-border bg-accent text-accent-foreground"
                      : "border border-border bg-card text-card-foreground",
                ]}
              >
                {cell.day !== null ? (
                  <>
                    {cell.canBlock && cell.dayKey !== null ? (
                      <a
                        href={`/dashboard?month=${month}&day=${cell.dayKey}`}
                        class="text-primary text-sm font-medium hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
                      >
                        {cell.day}
                      </a>
                    ) : (
                      <p class="text-sm font-medium">{cell.day}</p>
                    )}
                    {cell.wholeDayBlocked ? (
                      <p class="mt-1 text-sm">Dzień zablokowany</p>
                    ) : cell.blockedHours.length > 0 ? (
                      <ul class="mt-1 space-y-1">
                        {cell.blockedHours.map((label) => (
                          <li class="text-sm">{label}</li>
                        ))}
                      </ul>
                    ) : null}
                    {cell.items.length > 0 ? (
                      <ul class="mt-1 space-y-1">
                        {cell.items.map((item) => (
                          <li>
                            <a
                              href={`/dashboard/${item.id}`}
                              class="text-primary block min-w-0 text-sm break-all hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
                            >
                              {item.dogName} {item.time}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </>
                ) : null}
              </div>
            ))}
          </div>

          {showPanel ? (
            <section class="mt-8 rounded-xl border border-border bg-card p-4 text-card-foreground">
              <h2 class="text-lg font-semibold text-foreground">{panelHeading}</h2>
              {panelCovered ? null : (
                <form method="POST" action="/api/availability-blocks" class="mt-3 space-y-3">
                  <input type="hidden" name="day" value={selectedDay} />
                  <div class="flex flex-wrap gap-3">
                    <label class="flex items-center gap-3 text-sm">
                      <input type="checkbox" name="whole_day" value="1" />
                      Cały dzień
                    </label>
                    {openHours.map((hour) => (
                      <label class="flex items-center gap-3 text-sm">
                        <input type="checkbox" name="hour" value={hour} />
                        {formatHour(hour)}
                      </label>
                    ))}
                  </div>
                  <button
                    type="submit"
                    class="text-primary text-sm font-medium hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
                  >
                    Zapisz
                  </button>
                </form>
              )}
              {panelBlocks.length > 0 ? (
                <ul class="mt-3 space-y-3">
                  {panelBlocks.map((row) => (
                    <li>
                      <form
                        method="POST"
                        action="/api/availability-blocks/delete"
                        class="flex flex-wrap items-center justify-between gap-3"
                      >
                        <input type="hidden" name="id" value={row.id} />
                        <input type="hidden" name="day" value={selectedDay} />
                        <span class="text-sm">{blockRowLabel(row, selectedDay)}</span>
                        <button
                          type="submit"
                          class="text-primary text-sm font-medium hover:underline focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
                        >
                          Usuń
                        </button>
                      </form>
                    </li>
                  ))}
                </ul>
              ) : null}
            </section>
          ) : null}

          {submissions.length === 0 ? (
            <p class="mt-8 rounded-xl border border-border bg-card px-4 py-3 text-card-foreground" role="status">
              Nie ma zgłoszeń do pokazania.
            </p>
          ) : (
            <>
              <h2 class="mt-8 text-lg font-semibold text-foreground">Wszystkie zgłoszenia</h2>
              <ul class="mt-3 space-y-3">
                {submissions.map((submission) => (
                  <li>
                    <a
                      href={`/dashboard/${submission.id}`}
                      class="bg-card text-card-foreground block rounded-xl border border-border p-4 hover:bg-accent focus-visible:ring-ring focus-visible:ring focus-visible:outline-none"
                    >
                      <span class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                        <span class="font-semibold">{submission.dog_name}</span>
                        <span class="text-sm font-medium">{statusLabel(submission.status)}</span>
                      </span>
                      <span class="text-muted-foreground mt-1 block text-sm">{submission.breed}</span>
                      <span class="mt-2 block text-sm">{formatSlotLabel(submission.slot_start)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      )}
    </div>
  </div>
</Layout>
