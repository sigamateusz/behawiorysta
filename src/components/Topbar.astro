---
import { Button } from "@/components/ui/button";

const { user, role } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-border bg-card px-4 py-2 text-sm text-card-foreground">
  {user ? (
    <>
      <span class="text-muted-foreground">{user.email}</span>
      <div class="flex items-center gap-3">
        {role === "client" ? (
          <a
            href="/consultations"
            class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-ring focus-visible:ring"
          >
            Moje konsultacje
          </a>
        ) : (
          <a
            href="/dashboard"
            class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-ring focus-visible:ring"
          >
            Dashboard
          </a>
        )}
        <form method="POST" action="/api/auth/signout">
          <Button variant="link" type="submit" client:load>
            Sign out
          </Button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a
          href="/auth/signin"
          class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-ring focus-visible:ring"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-ring focus-visible:ring"
        >
          Sign up
        </a>
      </div>
    </>
  )}
</div>
